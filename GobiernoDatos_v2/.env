# ==============================================================================
# 🛡️ CONFIGURACIÓN DE VARIABLES DE ENTORNO - AGENTE DE GOBIERNO DE DATOS GCP
# ==============================================================================

# Proyecto GCP Host Principal (Donde se despliega la plataforma y APIs centrales)
GCP_HOST_PROJECT_ID=

# Región principal para Dataplex, Data Catalog y Cloud DLP
GCP_LOCATION=us-central1

# Lista de Proyectos GCP Habilitados para Gobierno por Defecto (separados por coma)
GCP_GOVERNED_PROJECTS=

# Tipo de credenciales (ADC: Application Default Credentials)
GCP_CREDENTIALS_TYPE=ADC

# Configuración del Servidor Web FastAPI / Uvicorn
HOST=0.0.0.0
PORT=8085

GOOGLE_CLIENT_ID=

# --- AGENTE BIGQUERY STUDIO (CONVERSATIONAL ANALYTICS) ---
BQ_DATA_AGENT_ID=agent_d74dd4e9-e294-4834-9b6d-a00fff8f0950
BQ_DATA_AGENT_PROJECT_ID=gobiernodatos
BQ_DATA_AGENT_LOCATION=us
