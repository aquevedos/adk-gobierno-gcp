# ==============================================================================
# 🛡️ PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Proyecto GCP Host Principal
GCP_HOST_PROJECT_ID=tu-proyecto-host-gcp

# Región GCP por defecto
GCP_LOCATION=us-central1

# Proyectos de la organización a gobernar (separados por coma)
GCP_GOVERNED_PROJECTS=tu-proyecto-host-gcp,proyecto-analitica-prod,proyecto-data-lake

# Tipo de Autenticación
GCP_CREDENTIALS_TYPE=ADC

# Servidor Web
HOST=0.0.0.0
PORT=8001

# Google OAuth 2.0 Web Client ID (GCP Console > APIs & Services > Credentials)
# Asegurar que http://localhost:8001 esté en Orígenes autorizados de JavaScript
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
